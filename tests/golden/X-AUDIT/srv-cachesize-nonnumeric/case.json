{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "server cacheSize not a number",
 "args": [
  "--config",
  "p.properties",
  "--port",
  "19191"
 ],
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "files": {
  "p.properties": "cacheSize=abc\n"
 }
}
