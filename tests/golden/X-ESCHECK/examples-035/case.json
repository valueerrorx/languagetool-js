{"kind":"harness","clock":"fixed","description":"es grammar.xml example sentences 3500.., DEFAULT","normalize":["paths"],"compare":"check","ops":[{"op":"check","args":{"lang":"es","text":"Sostiene el punto de vista de que uno no necesita amigos."}},{"op":"check","args":{"lang":"es","text":"Es fácil de que volvamos a encontrarnos"}},{"op":"check","args":{"lang":"es","text":"Estaba pensando si es posible de que entregues eso hoy."}},{"op":"check","args":{"lang":"es","text":"Encontrarás útil que hayan cambiado el cartel"}},{"op":"check","args":{"lang":"es","text":"formaron parte de ese Estado antes de que existiera"}},{"op":"check","args":{"lang":"es","text":"Estoy orgulloso de que mi padre sea un buen cocinero."}},{"op":"check","args":{"lang":"es","text":"Me alegra de que volvamos a encontrarnos"}},{"op":"check","args":{"lang":"es","text":"Me alegró de que volvamos a encontrarnos"}},{"op":"check","args":{"lang":"es","text":"Nos alegró de que volvamos a encontrarnos"}},{"op":"check","args":{"lang":"es","text":"Me entristece que hayan cambiado el cartel"}},{"op":"check","args":{"lang":"es","text":"Se alegró de que vinieran."}},{"op":"check","args":{"lang":"es","text":"Se alegraron de que vinieran."}},{"op":"check","args":{"lang":"es","text":"Nos alegramos de que vinieran."}},{"op":"check","args":{"lang":"es","text":"Y a no ser de que vengas"}},{"op":"check","args":{"lang":"es","text":"A medida de que lleguen."}},{"op":"check","args":{"lang":"es","text":"Una vez de que lleguen."}},{"op":"check","args":{"lang":"es","text":"Hay que esperar turno, dado a que en muchas ciudades la oferta es menor."}},{"op":"check","args":{"lang":"es","text":"Venían detrás mío."}},{"op":"check","args":{"lang":"es","text":"Venían atrás mío."}},{"op":"check","args":{"lang":"es","text":"Tengo a los niños encima de mí."}},{"op":"check","args":{"lang":"es","text":"Venían detrás tuyo."}},{"op":"check","args":{"lang":"es","text":"Iba adelante tuyo."}},{"op":"check","args":{"lang":"es","text":"Tienes a los niños encima de ti."}},{"op":"check","args":{"lang":"es","text":"Venían detrás nuestro."}},{"op":"check","args":{"lang":"es","text":"Vivían arriba nuestro."}},{"op":"check","args":{"lang":"es","text":"Tenemos a los niños encima de nosotros."}},{"op":"check","args":{"lang":"es","text":"Venían detrás vuestro."}},{"op":"check","args":{"lang":"es","text":"Tenemos a los niños encima de vosotros."}},{"op":"check","args":{"lang":"es","text":"Venían detrás suya."}},{"op":"check","args":{"lang":"es","text":"Vivían abajo suyo."}},{"op":"check","args":{"lang":"es","text":"Tienen a los niños encima de ellos."}},{"op":"check","args":{"lang":"es","text":"No contad con nosotros."}},{"op":"check","args":{"lang":"es","text":"Nunca contéis conmigo."}},{"op":"check","args":{"lang":"es","text":"Y si no enviadle recuerdos."}},{"op":"check","args":{"lang":"es","text":"Hubieron varios disparos"}},{"op":"check","args":{"lang":"es","text":"Habían como mínimo cinco."}},{"op":"check","args":{"lang":"es","text":"Hubo varios disparos"}},{"op":"check","args":{"lang":"es","text":"Hubiera sido peor si no vienen."}},{"op":"check","args":{"lang":"es","text":"Ellos habían nacido para jugar."}},{"op":"check","args":{"lang":"es","text":"De la dinastía Han."}},{"op":"check","args":{"lang":"es","text":"Han habido varios disparos"}},{"op":"check","args":{"lang":"es","text":"Habían habido como mínimo cinco."}},{"op":"check","args":{"lang":"es","text":"Si no hubiesen habido tantos casos, se habría acabado."}},{"op":"check","args":{"lang":"es","text":"Han habido de hacerlo."}},{"op":"check","args":{"lang":"es","text":"Pueden haber cuatro."}},{"op":"check","args":{"lang":"es","text":"Deben de haber cuatro."}},{"op":"check","args":{"lang":"es","text":"Podrían haber discrepancias"}},{"op":"check","args":{"lang":"es","text":"Puede haber cuatro."}},{"op":"check","args":{"lang":"es","text":"Pude haber hecho algo mal."}},{"op":"check","args":{"lang":"es","text":"va a poder haber una alarma"}},{"op":"check","args":{"lang":"es","text":"Tienen que haber cuatro."}},{"op":"check","args":{"lang":"es","text":"Tenían que haber cuatro."}},{"op":"check","args":{"lang":"es","text":"Pude haber cuatro."}},{"op":"check","args":{"lang":"es","text":"debiéndose haber dicho"}},{"op":"check","args":{"lang":"es","text":"El escándalo ha salpicada a todo el mundo."}},{"op":"check","args":{"lang":"es","text":"El escándalo ha salpicadas a todo el mundo."}},{"op":"check","args":{"lang":"es","text":"Se han empadronados 40 personas más."}},{"op":"check","args":{"lang":"es","text":"Había determinadas posibilidades,"}},{"op":"check","args":{"lang":"es","text":"Espero que no haya malentendidos."}},{"op":"check","args":{"lang":"es","text":"Existen unas 1.900.000 ha desarboladas."}},{"op":"check","args":{"lang":"es","text":"Durante ese mismo curso había abiertos en la Comunidad 1.531 centros."}},{"op":"check","args":{"lang":"es","text":"En el 2006 había empadronados en España 618.332 ciudadanos."}},{"op":"check","args":{"lang":"es","text":"Se habían clasificados todos."}},{"op":"check","args":{"lang":"es","text":"Habían clasificados todos los documentos."}},{"op":"check","args":{"lang":"es","text":"Se había clasificados todos."}},{"op":"check","args":{"lang":"es","text":"Ha dispuestos que sea así."}},{"op":"check","args":{"lang":"es","text":"Se han habilitados dos marquesinas metálicas."}},{"op":"check","args":{"lang":"es","text":"Hay clasificados."}},{"op":"check","args":{"lang":"es","text":"Había clasificados."}},{"op":"check","args":{"lang":"es","text":"Me parece que no va a haber entrevistas."}},{"op":"check","args":{"lang":"es","text":"Me parecía que no había salida a nuestro predicamento."}},{"op":"check","args":{"lang":"es","text":"En la ventana había sentada una niña con cara pensativa."}},{"op":"check","args":{"lang":"es","text":"Los géneros pueden haber cambiados."}},{"op":"check","args":{"lang":"es","text":"Se puede haber cambiados."}},{"op":"check","args":{"lang":"es","text":"No sabemos si va a haber clasificados."}},{"op":"check","args":{"lang":"es","text":"Debe haber clasificados."}},{"op":"check","args":{"lang":"es","text":"Suele haber clasificados."}},{"op":"check","args":{"lang":"es","text":"Puede haber clasificados"}},{"op":"check","args":{"lang":"es","text":"No se han realizando."}},{"op":"check","args":{"lang":"es","text":"No se han realizar."}},{"op":"check","args":{"lang":"es","text":"Habían defendiendo el resultado."}},{"op":"check","args":{"lang":"es","text":"Entre lo que hay consideramos que sí."}},{"op":"check","args":{"lang":"es","text":"Habían considerado la cuestión."}},{"op":"check","args":{"lang":"es","text":"Que haya malentendidos."}},{"op":"check","args":{"lang":"es","text":"Había como mínimo cinco."}},{"op":"check","args":{"lang":"es","text":"Allí no ha llovido."}},{"op":"check","args":{"lang":"es","text":"Lo que había era una falta de respeto."}},{"op":"check","args":{"lang":"es","text":"Se han encontraron indicios."}},{"op":"check","args":{"lang":"es","text":"Se han consideran indicios."}},{"op":"check","args":{"lang":"es","text":"¡Como te agarre, te se cae el pelo!"}},{"op":"check","args":{"lang":"es","text":"Lo agarraron y se le cayó el pelo."}},{"op":"check","args":{"lang":"es","text":"Las cifras indican a grosso modo que la gestión es correcta."}},{"op":"check","args":{"lang":"es","text":"La Tierra se encuentra, dicho grosso modo, a ocho minutos-luz del Sol."}},{"op":"check","args":{"lang":"es","text":"Imagino que sin en cambio está de acuerdo."}},{"op":"check","args":{"lang":"es","text":"La Tierra se encuentra, en cambio, a ocho minutos-luz del Sol."}},{"op":"check","args":{"lang":"es","text":"Imagino que ni si quiera está de acuerdo."}},{"op":"check","args":{"lang":"es","text":"La que sí quiera, puede venir."}},{"op":"check","args":{"lang":"es","text":"Su sino siempre fue traumático."}},{"op":"check","args":{"lang":"es","text":"Ella siempre le echó la culpa a su familia del sino trágico que la perseguía."}},{"op":"check","args":{"lang":"es","text":"Nuestro sino siempre nos pondrá en pensar."}}]}
