{
 "kind": "http",
 "clock": "fixed",
 "description": "maxTextLength / maxTextHardLength via --config",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "maxTextLength=30\nmaxTextHardLength=40\ncacheSize=10\n"
 },
