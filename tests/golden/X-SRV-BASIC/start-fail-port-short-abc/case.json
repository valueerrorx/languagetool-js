{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "server start failure: -p 8x",
 "args": [
  "-p",
  "8x"
 ]
}
