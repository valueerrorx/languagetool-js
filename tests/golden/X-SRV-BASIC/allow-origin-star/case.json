{
 "kind": "http",
 "clock": "fixed",
 "description": "--allow-origin without value -> *",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "serverArgs": [
  "--allow-origin"
 ],
 "requests": [
  {
   "method": "GET",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "x"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {}
  },
  {
   "method": "GET",
   "path": "/v2/maxtextlength"
  },
  {
   "method": "GET",
   "path": "/v2/healthcheck"
  },
  {
   "method": "GET",
   "path": "/v2/nothing"
  },
  {
   "method": "GET",
   "path": "/favicon.ico"
  },
  {
   "method": "GET",
   "path": "/"
  },
  {
   "method": "OPTIONS",
   "path": "/v2/check"
  }
 ]
}
