{
 "kind": "http",
 "clock": "fixed",
 "description": "unknown options and --option=value are ignored (SRV-0004)",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "serverArgs": [
  "--bogus",
  "--allow-origin=https://x.example",
  "-v"
 ],
 "requests": [
  {
   "method": "GET",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "x"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {}
  }
 ]
}
