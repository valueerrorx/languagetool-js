{
 "kind": "http",
 "clock": "fixed",
 "description": "rulesFile (.languagetool.cfg style) configures every pipeline (SRV-0041)",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "rulesFile={WORK}/rules.cfg\n",
  "rules.cfg": "disabledRules.en=DOUBLE_PUNCTUATION\nenabledRules.en=WHITESPACE_RULE\nmotherTongue=de\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.. And (bracket  open.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.. And (bracket  open.",
    "enabledRules": "DOUBLE_PUNCTUATION",
    "enabledOnly": "true"
   }
  }
 ]
}
