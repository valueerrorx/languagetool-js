{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "dbDriver/Url/Username/Password set, driver class not available (server starts, no connection yet)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18158"
 ],
 "files": {
  "c.properties": "dbDriver=org.nonexistent.Driver\ndbUrl=jdbc:x:y\ndbUsername=u\ndbPassword=p\n"
 }
}
