{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "premiumOnly=true in the open source build",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18163"
 ],
 "files": {
  "c.properties": "premiumOnly=true\n"
 }
}
