{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--port 0 where only the max port is free (range is inclusive)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--port",
  "0",
  "--config",
  "c.properties"
 ],
 "files": {
  "c.properties": "minPort=18180\nmaxPort=18182\n"
 },
 "occupyPorts": [
  18180,
  18181
 ]
}
