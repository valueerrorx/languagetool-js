{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "fasttextModel is a directory",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18157"
 ],
 "files": {
  "c.properties": "fasttextModel=mdir\nfasttextBinary=/bin/true\n",
  "mdir/x": "x"
 }
}
