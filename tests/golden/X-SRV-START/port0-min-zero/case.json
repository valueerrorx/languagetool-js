{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--port 0 with minPort=0",
 "stderrExceptionOnly": true,
 "args": [
  "--port",
  "0",
  "--config",
  "c.properties"
 ],
 "files": {
  "c.properties": "minPort=0\nmaxPort=18180\n"
 }
}
