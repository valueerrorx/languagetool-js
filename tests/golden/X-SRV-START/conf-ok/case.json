{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "confidence file for en and de",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18171"
 ],
 "files": {
  "c.properties": "ruleIdToConfidenceFile=conf-{lang}.csv\n",
  "conf-en.csv": "# c\nCOMMA_PARENTHESIS_WHITESPACE,0.5,extra\nDOUBLE_PUNCTUATION,1\n",
  "conf-de.csv": "WHITESPACE_RULE,0.25\n"
 }
}
