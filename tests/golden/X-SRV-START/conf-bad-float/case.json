{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "confidence file with a bad float",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18169"
 ],
 "files": {
  "c.properties": "ruleIdToConfidenceFile=conf-{lang}.csv\n",
  "conf-en.csv": "COMMA_PARENTHESIS_WHITESPACE,abc\n"
 }
}
