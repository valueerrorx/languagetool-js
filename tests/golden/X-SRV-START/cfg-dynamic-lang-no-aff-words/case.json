{
 "kind": "http",
 "clock": "fixed",
 "description": "dynamic language with suffix flag: foos accepted via foo/S, Bär",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "lang-tr=Turkish\nlang-tr-dictPath={WORK}/dyn/tr.dic\n",
  "dyn/tr.dic": "4\nhello\nworld\nfoo/S\nBär\n",
  "dyn/tr.aff": "SET UTF-8\nSFX S Y 1\nSFX S 0 s .\n",
  "dyn/common_words.txt": "hello\nworld\nfoo\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "tr",
    "text": "foos foo foo, Bär bär BÄR"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "tr",
    "text": ""
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "tr",
    "text": "hello,, world"
   }
  }
 ]
}
