{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "dbLogging=true with only driver, url, username",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18154"
 ],
 "files": {
  "c.properties": "dbLogging=true\ndbDriver=x\ndbUrl=y\ndbUsername=z\n"
 }
}
