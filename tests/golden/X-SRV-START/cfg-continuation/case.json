{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "line continuation and escapes in keys and values",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18173"
 ],
 "files": {
  "c.properties": "longKey=part1\\\n   part2\nk\\ ey=v\nu\\u0041=\\u00e4\nx\\=y=z\n"
 }
}
