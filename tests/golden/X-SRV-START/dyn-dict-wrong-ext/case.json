{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "dictPath with extension .txt",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18150"
 ],
 "files": {
  "c.properties": "lang-tr=Turkish\nlang-tr-dictPath=dyn/tr.txt\n",
  "dyn/tr.dic": "4\nhello\nworld\nfoo/S\nBär\n",
  "dyn/tr.aff": "SET UTF-8\nSFX S Y 1\nSFX S 0 s .\n",
  "dyn/common_words.txt": "hello\nworld\nfoo\n",
  "dyn/tr.txt": "x"
 }
}
