{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "serverURL=/a%20b: getPath() decodes the escape, the second URI parse fails (SRV-0036)",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
