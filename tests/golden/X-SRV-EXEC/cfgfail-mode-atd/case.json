{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "config mode=AfterTheDeadline refused at startup",
 "args": [
  "--config",
  "bad.properties",
  "--port",
  "18391"
 ],
 "files": {
  "bad.properties": "mode=AfterTheDeadline\n"
 }
}
