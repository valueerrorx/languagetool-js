{
 "kind": "http",
 "clock": "fixed",
 "description": "requestLimit configured: username/apiKey requests fail in the limiter path (403 AuthException) before counting",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "limits-auth-requestlimit",
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "requestLimit=2\nrequestLimitPeriodInSeconds=3600\nrequestLimitWhitelistUsers=a@b.com\nrequestLimitWhitelistLimit=10\n"
 },
