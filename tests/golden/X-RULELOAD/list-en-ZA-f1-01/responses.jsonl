":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Use <suggestion>enough</suggestion>."},{"fullId":"TAKE_ACTION_TO[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Remove as verbose."},{"fullId":"THAT_EXISTS[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Try removing the phrase."},{"fullId":"THE_UNDERSIGNED[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Legalese. Did you mean <suggestion>I</suggestion>, <suggestion>me</suggestion> or <suggestion>we</suggestion>?"},{"fullId":"TYPE_OF[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Try removing the phrase \"\\1 \\2\"."},{"fullId":"UNTIL_SUCH_TIME_AS[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Use <suggestion>until</suggestion>."},{"fullId":"WHAT_I_MEAN_TO_SAY_IS_THAT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":7,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Try removing the phrase."},{"fullId":"WITH_OR_IN_REFERENCE_OR_REGARD_TO[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Replace with shorter <suggestion>about</suggestion>, <suggestion>of</suggestion>, <suggestion>on</suggestion>, <suggestion>for</suggestion>, <suggestion>concerning</suggestion>, or <suggestion>regarding</suggestion>."},{"fullId":"WORTHWHILE[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Weak word. Use something stronger like <suggestion>valuable</suggestion>."},{"fullId":"YOU_ARE_REQUESTED[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Replace with <suggestion>please</suggestion>"},{"fullId":"DRAW_ATTENTION[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":5,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Replace with <suggestion>please see</suggestion> or <suggestion>please note</suggestion>"},{"fullId":"DRAW_ATTENTION[2]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Replace with <suggestion>point out</suggestion>."},{"fullId":"REFERRING_BACK[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Legalese. Bad style in any normal text