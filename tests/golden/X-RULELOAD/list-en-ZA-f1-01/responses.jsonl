h</suggestion> or <suggestion>though</suggestion>?"},{"fullId":"DESPITE_THE_FACT[2]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":6,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Did you mean <suggestion>although</suggestion>, <suggestion>even though</suggestion> or <suggestion>though</suggestion>?"},{"fullId":"IN_THE_AFFIRMATIVE[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Change to <suggestion>yes</suggestion> or <suggestion>affirmatively</suggestion>."},{"fullId":"IN_THE_CASE_OF[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Change to <suggestion>about</suggestion> or <suggestion>to</suggestion> and change the word order of the sentence."},{"fullId":"IN_THE_EVENT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Did you mean <suggestion>if</suggestion> or <suggestion>in case of</suggestion>?"},{"fullId":"IN_THE_FINAL_ANALYSIS[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Did you mean <suggestion>finally</suggestion> or <suggestion>in conclusion</suggestion>? You could remove the phase, too."},{"fullId":"IN_THE_NATURE_OF[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Did you mean <suggestion>like</suggestion>?"},{"fullId":"IN_THE_NEIGHBORHOOD_OF[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Can be used as <suggestion>almost</suggestion>, <suggestion>approximately</suggestion>, <suggestion>more or less</suggestion>, <suggestion>around</suggestion>. Often <suggestion>about</suggestion>."},{"fullId":"IN_THE_PROCESS_OF[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":4,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Possibly empty phrase \"\\1 \\2 \\3 \\4\" when it means \"currently\"."},{"fullId":"IT_SEEMS_OR_APPEARS_THAT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Possibly empty phrase \"\\1 \\2 \\3\""},{"fullId":"MAJORITY[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Majority in the sense of \"more than half\" is used with countable nouns only (esp. when voting); for uncountable nouns, use <suggestion>most</suggestion> or <suggestion>usually</suggestion>."},{"fullId":"MAKE_DECISIONS_ABOUT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Did you mean <suggestion>decide on</suggestion>?"},{"fullId":"MAKE_AN_ATTEMPT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Can you write <suggestion>\\1</suggestion> and still be correct?"},{"fullId":"NOT_ABLE[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Avoid using \"not\". Did you mean <suggestion>unable</suggestion>?"},{"fullId":"NOT_ACCEPT[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Avoid using \"not\". Did you mean <suggestion>reject</suggestion>?"},{"fullId":"NOT_CERTAIN[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Avoid using \"not\". Did you mean <suggestion>uncertain</suggestion>?"},{"fullId":"NOT_UNLIKE[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Avoid using \"not\". Did you mean <suggestion>similar</suggestion> or <suggestion>alike</suggestion>?"},{"fullId":"NOT_MANY[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Avoid using \"not\". Did you mean <suggestion>few</suggestion>?"},{"fullId":"NOT_VERY_OFTEN[1]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":3,"antiPatterns":0,"sourc