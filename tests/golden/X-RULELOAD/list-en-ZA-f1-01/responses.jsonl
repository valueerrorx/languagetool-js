Count":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Although '\\1 \\2' is correct, it is not always necessary. If possible, use only <suggestion>\\1</suggestion>."},{"fullId":"EMPHATIC_REFLEXIVE_PRONOUNS[5]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Although '\\1 \\2' is correct, it is not always necessary. If possible, use only <suggestion>\\1</suggestion>."},{"fullId":"EMPHATIC_REFLEXIVE_PRONOUNS[6]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Although '\\1 \\2' is correct, it is not always necessary. If possible, use only <suggestion>\\1</suggestion>."},{"fullId":"EMPHATIC_REFLEXIVE_PRONOUNS[7]","class":"PatternRule","category":"PLAIN_ENGLISH","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Although '\\1 \\2' is correct, it is not always necessary. If possible, use only <suggestion>\\1</suggestion>."},{"fullId":"HASH_SYMBOL[1]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"#\" with <suggestion>No. </suggestion> or <suggestion>number </suggestion> when referring to numbers or rankings."},{"fullId":"WIKIPEDIA_12_PM[1]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"12 pm\" with <suggestion>noon</suggestion> for clarity."},{"fullId":"WIKIPEDIA_12_AM[1]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"12 am\" with <suggestion>midnight</suggestion> for clarity."},{"fullId":"WIKIPEDIA_CURRENTLY[1]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"currently\" with a specific date, as \"currently\" will change over time."},{"fullId":"WIKIPEDIA_CONTRACTIONS[1]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"wasn't\" with <suggestion>was not</suggestion>."},{"fullId":"WIKIPEDIA_CONTRACTIONS[2]","class":"PatternRule","category":"WIKIPEDIA","defaultOff":false,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":2,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"Wikipedia style. Replace \"it's\" with <suggestion>it is</suggestion>"},{"fullId":"E_PRIME_STRICT[1]","class":"PatternRule","category":"CREATIVE_WRITING","defaultOff":true,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":0,"sourceFile":"/org/languagetool/rules/en/style.xml","message":"According to E-Prime, avoiding the use of the stative verb 'to be' makes the communication clearer, more accurate, and less dogmatic. Use an alternative verb."},{"fullId":"E_PRIME_LOOSE[1]","class":"PatternRule","category":"CREATIVE_WRITING","defaultOff":true,"defaultTempOff":false,"premium":false,"priority":0,"tokenCount":1,"antiPatterns":1,"sourceFile":"/org/languagetool/rules/en/style.xml","messag