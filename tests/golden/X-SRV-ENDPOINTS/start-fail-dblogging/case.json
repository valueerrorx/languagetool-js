{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "dbLogging=true without dbDriver is rejected at startup (SRV-0201)",
 "args": [
  "--config",
  "d.properties",
  "--port",
  "18292"
 ],
 "files": {
  "d.properties": "dbLogging=true\n"
 }
}
