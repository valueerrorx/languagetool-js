{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "CLI-0035: line/column refer to filtered text",
 "args": [
  "-l",
  "en-US",
  "-eo",
  "-e",
  "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,UPPERCASE_SENTENCE_START,WHITESPACE_RULE,EN_UNPAIRED_BRACKETS,ENGLISH_WORD_REPEAT_RULE,SENTENCE_WHITESPACE",
  "--xmlfilter",
  "-"
 ],
 "stdin": "<a>\n<b>one one</b>\n</a>\nlast  line"
}
