{
 "kind": "http",
 "clock": "fixed",
 "description": "fingerprint parts: Accept-Language, Referer, textSessionId distinguish clients behind one IP (factor 3)",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
