{
 "kind": "http",
 "clock": "fixed",
 "description": "503 error carries Access-Control-Allow-Origin",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "--allow-origin",
  "*",
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "maxCheckThreads=1\nmaxWorkQueueSize=1\n"
 },
 "requests": [
  {
   "hold": {
    "path": "/v2/check",
    "contentLength": 200,
    "sent": 10,
    "holdMs": 500,
    "settleMs": 800,
    "probes": [
     {
      "method": "GET",
      "path": "/v2/healthcheck"
     },
     {
      "method": "GET",
      "path": "/v2/healthcheck"
     },
     {
      "method": "GET",
      "path": "/"
     }
    ]
   }
  }
 ]
}
