{"kind":"harness","clock":"fixed","description":"pl disambiguation.xml example sentences through all rules","normalize":["paths"],"compare":"check","ops":[{"op":"check","args":{"lang":"pl","text":"Czyż nie znajdziemy prawidła?"}},{"op":"check","args":{"lang":"pl","text":"Odrzuciliście jedno, a zachowali drugie: czyż kochacie z racji rozumu?"}},{"op":"check","args":{"lang":"pl","text":"Jaka ona szlachetna!"}},{"op":"check","args":{"lang":"pl","text":"Udomowiony jak występuje w centralnej Azji."}},{"op":"check","args":{"lang":"pl","text":"Jestem wesoły jak staruszek."}},{"op":"check","args":{"lang":"pl","text":"Wręcz mi plik banknotów!"}},{"op":"check","args":{"lang":"pl","text":"Trwała walka wręcz."}},{"op":"check","args":{"lang":"pl","text":"On wybrania wszystkie."}},{"op":"check","args":{"lang":"pl","text":"Konieczność ponownego wybrania numeru."}},{"op":"check","args":{"lang":"pl","text":"Kosę, niby szablę, pod słońce obejrzał."}},{"op":"check","args":{"lang":"pl","text":"Ale niby dokąd?"}},{"op":"check","args":{"lang":"pl","text":"No i oto dlaczego mnie nie lubią."}},{"op":"check","args":{"lang":"pl","text":"Daj mi krowę."}},{"op":"check","args":{"lang":"pl","text":"Do re mi!"}},{"op":"check","args":{"lang":"pl","text":"Pod tym względem Brazylia jest szczególna."}},{"op":"check","args":{"lang":"pl","text":"Nie bądź względem niego taki ostry!"}},{"op":"check","args":{"lang":"pl","text":"Było to godzinę temu."}},{"op":"check","args":{"lang":"pl","text":"Nie dziwię się temu."}},{"op":"check","args":{"lang":"pl","text":"To było już godzinę temu."}},{"op":"check","args":{"lang":"pl","text":"Dziwię się temu zachowaniu."}},{"op":"check","args":{"lang":"pl","text":"O „Gwiazdorze” powiedział coś ciekawego."}},{"op":"check","args":{"lang":"pl","text":"O, idzie kościelny!"}},{"op":"check","args":{"lang":"pl","text":"O łajdak!"}},{"op":"check","args":{"lang":"pl","text":"Porozmawiajmy o literaturze."}},{"op":"check","args":{"lang":"pl","text":"O. Pio nie jadał pierogów."}},{"op":"check","args":{"lang":"pl","text":"Ale o bogowie i boginie!"}},{"op":"check","args":{"lang":"pl","text":"O bogowie i boginie!"}},{"op":"check","args":{"lang":"pl","text":"O sprawiedliwości społecznej niech świadczy fakt…"}},{"op":"check","args":{"lang":"pl","text":"Ależ o panie łaskawy!"}},{"op":"check","args":{"lang":"pl","text":"To jest o. Pio."}},{"op":"check","args":{"lang":"pl","text":"Spotykamy się o dwunastej"}},{"op":"check","args":{"lang":"pl","text":"Na Filipinach są gwoździe."}},{"op":"check","args":{"lang":"pl","text":"Na, masz pismo, czytaj."}},{"op":"check","args":{"lang":"pl","text":"Na tu, piesku"}},{"op":"check","args":{"lang":"pl","text":"Spotykamy się na parterze."}},{"op":"check","args":{"lang":"pl","text":"Ha, może to prawda?"}},{"op":"check","args":{"lang":"pl","text":"To litera ha."}},{"op":"check","args":{"lang":"pl","text":"Ano tak."}},{"op":"check","args":{"lang":"pl","text":"Ano, ni mniej, ni więcej."}},{"op":"check","args":{"lang":"pl","text":"Ludwiku, kup ciastka!"}},{"op":"check","args":{"lang":"pl","text":"Ludwiku, lub lubelskie!"}},{"op":"check","args":{"lang":"pl","text":"Ludwiku lub lubelskie!"}},{"op":"check","args":{"lang":"pl","text":"Jako, a idźże mi stąd!"}},{"op":"check","args":{"lang":"pl","text":"Szedł wskroś krzewów."}},{"op":"check","args":{"lang":"pl","text":"Przebijał mu na wskroś tarczę."}},{"op":"check","args":{"lang":"pl","text":"Bez małej czarnej nie wstanę."}},{"op":"check","args":{"lang":"pl","text":"Bez mała wszyscy to robią."}},{"op":"check","args":{"lang":"pl","text":"Zdaje się z gruba ciosany."}},{"op":"check","args":{"lang":"pl","text":"Ona jest gruba."}},{"op":"check","args":{"lang":"pl","text":"Choć to jest trochę błędne koło, bo z drugiej strony trzeba być sobą."}},{"op":"check","args":{"lang":"pl","text":"To jest koło zamachowe gospodarki!"}},{"op":"check","args":{"lang":"pl","text":"Mieszkam koło Grójca."}},{"op":"check","args":{"lang":"pl","text":"Będzin (Bendzin), Grodno, Kalisz, Koło, Lipno."}},{"op":"check","args":{"lang":"pl","text":"On się przyjaźni z dżdżownicą."}},{"op":"check","args":{"lang":"pl","text":"Miesiąc przyjaźni polsko-radzieckiej"}},{"op":"check","args":{"lang":"pl","text":"Ach, piękne niebo Italii, wykwintne życie jej dworów, miast, czary poezji, miłości, sztuki!"}},{"op":"check","args":{"lang":"pl","text":"Ach, piękne niebo Italii, wykwintne życie jej dworów, miast i wsi!"}},{"op":"check","args":{"lang":"pl","text":"Ach, piękne niebo Italii, wykwintne życie jej dworów, wsi i miast włoskich!"}},{"op":"check","args":{"lang":"pl","text":"Po kilku minutach, nim krzyki ustały, zaszedł fakt…"}},{"op":"check","args":{"lang":"pl","text":"Obmyślał był nową zdradę."}},{"op":"check","args":{"lang":"pl","text":"To może byś coś zrobił?"}},{"op":"check","args":{"lang":"pl","text":"To byś może coś zrobił?"}},{"op":"check","args":{"lang":"pl","text":"Wydawało się, sam Bóg chce, by nastanie nowego porządku poprzedziła zagłada starego."}},{"op":"check","args":{"lang":"pl","text":"Świeć oczom moim, nim je bielmo gorąco pożądanej śmierci przysłoni!"}},{"op":"check","args":{"lang":"pl","text":"Krzysztof był postacią charyzmatyczną i praca z nim była wzniosłością."}},{"op":"check","args":{"lang":"pl","text":"Byłoby nastanie nowego porządku zagładą starego?"}},{"op":"check","args":{"lang":"pl","text":"Albo nie."}},{"op":"check","args":{"lang":"pl","text":"—„Albo nie”."}},{"op":"check","args":{"lang":"pl","text":"Ale to nieprawda."}},{"op":"check","args":{"lang":"pl","text":"Ale, ale, byłbym zapomniał!"}},{"op":"check","args":{"lang":"pl","text":"To prawda, ale co z tego?"}},{"op":"check","args":{"lang":"pl","text":"Ale są głupcami."}},{"op":"check","args":{"lang":"pl","text":"– Ale są głupcami."}},{"op":"check","args":{"lang":"pl","text":"PAN: Ale co z tego?"}},{"op":"check","args":{"lang":"pl","text":"Nie wiem, ale czemu pytasz?"}},{"op":"check","args":{"lang":"pl","text":"Objawy cofają się lub stają się bardzo łagodne."}},{"op":"check","args":{"lang":"pl","text":"Lub robić coś!"}},{"op":"check","args":{"lang":"pl","text":"Człowieku lub coś!"}},{"op":"check","args":{"lang":"pl","text":"Dojadę tam bądź rowerem, bądź hulajnogą."}},{"op":"check","args":{"lang":"pl","text":"Dojadę tam bądź rowerem bądź hulajnogą."}},{"op":"check","args":{"lang":"pl","text":"Dojadę tam bądź z Warszawy, bądź z Pcimia."}},{"op":"check","args":{"lang":"pl","text":"Dojadę tam bądź z Pcimia bądź z Warszawy."}},{"op":"check","args":{"lang":"pl","text":"Bądź pozdrowiony!"}},{"op":"check","args":{"lang":"pl","text":"Dawkę leku powtarzamy co dwa bądź trzy tygodnie."}},{"op":"check","args":{"lang":"pl","text":"Dawkę leku powtarzamy co dwa lub trzy tygodnie."}},{"op":"check","args":{"lang":"pl","text":"Takich spraw do „wyodrębniania” jest znacznie więcej i wiele z nich (na przykład związki gospodarki narodowej z gospodarką światową) sprawia znacznie większe trudności z punktu widzenia stworzenia odpowiednich przepisów regulujących postępowanie przedsiębiorstw."}},{"op":"check","args":{"lang":"pl","text":"Piętnaście i szesnaście."}},{"op":"check","args":{"lang":"pl","text":"Lecz że żaba była chora, nie chodziła do doktora."}},{"op":"check","args":{"lang":"pl","text":"Ludwiku, bądż że rozsądny!"}},{"op":"check","args":{"lang":"pl","text":"Aby podkreślić ładne powiedzenie siostry, bądź że zazdrościła Swannowi, ..."}},{"op":"check","args":{"lang":"pl","text":"Nie wypadało mu mówić głupstw, bądź co bądź reprezentował parlament."}},{"op":"check","args":{"lang":"pl","text":"„Bądź jak bądź – mówił do siebie Rzecki..."}},{"op":"check","args":{"lang":"pl","text":"Bądź co bądź to prawda."}},{"op":"check","args":{"lang":"pl","text":"Bądź zdrów."}},{"op":"check","args":{"lang":"pl","text":"Bądź to czysta serweta, bądź to brudna ścierka."}},{"op":"check","args":{"lang":"pl","text":"Wstał z łóżka, ubrał się jak bądź i bez kołnierzyka zbiegł czym prędzej do hallu."}},{"op":"check","args":{"lang":"pl","text":"Mówił bądź milczał."}},{"op":"check","args":{"lang":"pl","text":"Bądź zdrów!"}},{"op":"check","args":{"lang":"pl","text":"List ten piszę własną ręką, bądź więc ostrożny."}},{"op":"check","args":{"lang":"pl","text":"To wszystko bez względu na przynależność rasową bądź wyznaniową."}}]}
