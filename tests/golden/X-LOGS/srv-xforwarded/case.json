{
 "kind": "http",
 "clock": "fixed",
 "description": "trustXForwardForHeader=true: real client address in the L-IP line (allButTextLevelOnly)",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "srv-xforwarded",
 "realLogging": true,
 "captureLog": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
