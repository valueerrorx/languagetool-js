{
 "kind": "http",
 "clock": "fixed",
 "description": "abTest key: \"A/B-Test enabled\" line carries the configured list",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "srv-config-ab-test",
 "realLogging": true,
 "captureLog": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "abTest=SomeTest\nabTestClients=client1\nabTestRollout=50\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true",
    "useragent": "client1"
   }
  },
  {
   "method": "GET",
   "path": "/v2/healthcheck"
  }
 ]
}
