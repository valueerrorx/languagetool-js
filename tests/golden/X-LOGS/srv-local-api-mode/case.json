{
 "kind": "http",
 "clock": "fixed",
 "description": "localApiMode=true uses the SimpleLanguageIdentifier: its init and error-rate log lines",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "srv-local-api-mode",
 "realLogging": true,
 "captureLog": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "localApiMode=true\npreferredLanguages=en-US, de-DE\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "auto",
    "text": "This is a longer english sentence,, that the the detector can handle without any trouble.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE,UNPAIRED_BRACKETS,UNPAIRED_QUOTES,WORD_REPEAT_RULE,DE_DOUBLE_PUNCTUATION,DE_SENTENCE_WHITESPACE,DE_UNPAIRED_QUOTES,GERMAN_WORD_REPEAT_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "auto",
    "text": "Das ist ein ziemlich langer deutscher Satz,, den den der Detektor erkennen kann.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE,UNPAIRED_BRACKETS,UNPAIRED_QUOTES,WORD_REPEAT_RULE,DE_DOUBLE_PUNCTUATION,DE_SENTENCE_WHITESPACE,DE_UNPAIRED_QUOTES,GERMAN_WORD_REPEAT_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok.",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "GET",
   "path": "/v2/healthcheck"
  }
 ]
}
