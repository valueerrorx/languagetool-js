{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli-log",
 "realLogging": true,
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "-adl on a file argument",
