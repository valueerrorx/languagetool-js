{"kind":"harness","clock":"fixed","description":"pl disambiguation.xml example sentences through all rules","normalize":["paths"],"compare":"check","ops":[{"op":"check","args":{"lang":"pl","text":"Od kiedy należycie do Partii, towarzyszu?"}},{"op":"check","args":{"lang":"pl","text":"Nie zdążyła się należycie rozpatrzyć w nowych warunkach życia rodziny."}},{"op":"check","args":{"lang":"pl","text":"Jest mi jej żal."}},{"op":"check","args":{"lang":"pl","text":"Ale i wujkowi Władkowi żal się nagle tej czapki zrobiło."}},{"op":"check","args":{"lang":"pl","text":"Jajko stało na stole."}},{"op":"check","args":{"lang":"pl","text":"To stało się nagle."}},{"op":"check","args":{"lang":"pl","text":"To się stało nagle."}},{"op":"check","args":{"lang":"pl","text":"Być eleganckim jest nie sposób."}},{"op":"check","args":{"lang":"pl","text":"Nie sposób się do wojny."}},{"op":"check","args":{"lang":"pl","text":"Nie sposób jest być eleganckim."}},{"op":"check","args":{"lang":"pl","text":"Telefon to coś, bez czego nie sposób się obejść."}},{"op":"check","args":{"lang":"pl","text":"Nie sposób się w nim pogubić."}},{"op":"check","args":{"lang":"pl","text":"Nie sposób jest chętnie korzystać z cudzego nieszczęścia."}},{"op":"check","args":{"lang":"pl","text":"Nie sposób było wczoraj cieszyć się z cudzego nieszczęścia."}},{"op":"check","args":{"lang":"pl","text":"Telefon to coś, bez czego nie sposób będzie tak czy inaczej się obejść."}},{"op":"check","args":{"lang":"pl","text":"Muszę się w tym dobrze zorientować."}},{"op":"check","args":{"lang":"pl","text":"I cóż, stary Balu — dodała — jak żeś wyszedł z tej przygody?"}},{"op":"check","args":{"lang":"pl","text":"Ma przyjaciółka kupuje glizdy na targu."}},{"op":"check","args":{"lang":"pl","text":"Szczęście, niestety, ma to do siebie, że się kończy."}},{"op":"check","args":{"lang":"pl","text":"Szczęście, niestety, ma w sobie coś niepokojącego."}},{"op":"check","args":{"lang":"pl","text":"Jak ma być zrobione zadanie 3?"}},{"op":"check","args":{"lang":"pl","text":"Tak ma też być zrobione zadanie 3."}},{"op":"check","args":{"lang":"pl","text":"To być ma zadanie 3?"}},{"op":"check","args":{"lang":"pl","text":"Ułatwiać adopcję ma m.in. artykuł 118 kodeksu."}},{"op":"check","args":{"lang":"pl","text":"Sejm zajmować się ma tą sprawą."}},{"op":"check","args":{"lang":"pl","text":"To jest ma przyjaciółka."}},{"op":"check","args":{"lang":"pl","text":"Wcześniejszą genezę ma osada oraz kościoły."}},{"op":"check","args":{"lang":"pl","text":"A taką siłę ma praktycznie tylko armia."}},{"op":"check","args":{"lang":"pl","text":"Jedną koszulę ma na grzbiecie."}},{"op":"check","args":{"lang":"pl","text":"Rolę ma też osada oraz kościoły."}},{"op":"check","args":{"lang":"pl","text":"Zaprawdę skórę ma bardzo delikatną."}},{"op":"check","args":{"lang":"pl","text":"Formę ma pomarańczy."}},{"op":"check","args":{"lang":"pl","text":"Ma przyjaciółka robi na drutach."}},{"op":"check","args":{"lang":"pl","text":"Ode mnie dowiedział się, ile mamy dni zdjęciowych na reportaż."}},{"op":"check","args":{"lang":"pl","text":"Ma powierzchnię 462 km²."}},{"op":"check","args":{"lang":"pl","text":"Ma bardzo dużą powierzchnię 462 km²."}},{"op":"check","args":{"lang":"pl","text":"Natychmiast kombinował, jaki by tu numer wykręcić zapraszającemu."}},{"op":"check","args":{"lang":"pl","text":"Użył narzędzia, jakiego, by użyć tu mocnego określenia, nie powinien był używać."}},{"op":"check","args":{"lang":"pl","text":"Ciekawa to była figura i wiele by jeszcze o niej gadać."}},{"op":"check","args":{"lang":"pl","text":"Dałbym wiele, by jeszcze móc ją zobaczyć."}},{"op":"check","args":{"lang":"pl","text":"Oni powinni by to zrobić."}},{"op":"check","args":{"lang":"pl","text":"Ale nie w poprzek, jak powinna, by zagrodzić drogę nadjeżdżającej dziewczynie."}},{"op":"check","args":{"lang":"pl","text":"— Nie słyszałeś?"}},{"op":"check","args":{"lang":"pl","text":"Tu mam na myśli dzialałność usługową."}},{"op":"check","args":{"lang":"pl","text":"To był dzień naszych mam."}},{"op":"check","args":{"lang":"pl","text":"To był dzień mam pracujących."}},{"op":"check","args":{"lang":"pl","text":"Peja zamieścił apel rzekomej mamy Szymka."}},{"op":"check","args":{"lang":"pl","text":"Mam chwilową biegunkę."}},{"op":"check","args":{"lang":"pl","text":"Na klatce stał doktor Stachowiak."}},{"op":"check","args":{"lang":"pl","text":"Tu mamy piękny przykład pod względem architektury."}},{"op":"check","args":{"lang":"pl","text":"Tu mamy piękny przykład, względem którego nie będziemy się kierować."}},{"op":"check","args":{"lang":"pl","text":"Powinien był pójść do lekarza."}},{"op":"check","args":{"lang":"pl","text":"Winni są już ukarani."}},{"op":"check","args":{"lang":"pl","text":"Każdy winien przestrzegać prawa!"}},{"op":"check","args":{"lang":"pl","text":"Tak mówią winni!"}},{"op":"check","args":{"lang":"pl","text":"Ona była winna."}},{"op":"check","args":{"lang":"pl","text":"Iż winna latorośl wybrana wyda jeno ocet."}},{"op":"check","args":{"lang":"pl","text":"Otóż winni mi jesteście paszę"}},{"op":"check","args":{"lang":"pl","text":"Winna pójść do lekarza."}},{"op":"check","args":{"lang":"pl","text":"To nie przypadek, że ten wypadek zdarzył się tu."}},{"op":"check","args":{"lang":"pl","text":"Los tak zdarzył, mój panie."}},{"op":"check","args":{"lang":"pl","text":"Tak zdarzył los, mój panie."}},{"op":"check","args":{"lang":"pl","text":"ONZ wystosowała pismo do redakcji Przeglądu Wędkarskiego."}},{"op":"check","args":{"lang":"pl","text":"Do ONZ dotarło pismo z redakcji Przeglądu Wędkarskiego."}},{"op":"check","args":{"lang":"pl","text":"krystalochemiczna klasyfikacja amfiboli IMA (International Mineralogical Association)"}},{"op":"check","args":{"lang":"pl","text":"Tematem wiodącym tej książki są grzyby."}},{"op":"check","args":{"lang":"pl","text":"Szedłem drogą wiodącą w stronę wioski."}},{"op":"check","args":{"lang":"pl","text":"To jest problem."}},{"op":"check","args":{"lang":"pl","text":"Będzie to znaczyło podciąć zło przy samym korzeniu."}},{"op":"check","args":{"lang":"pl","text":"Jest to tylko problem."}},{"op":"check","args":{"lang":"pl","text":"Moja była to mówiła."}},{"op":"check","args":{"lang":"pl","text":"Będzie to wówczas znaczyło, że to prawda."}},{"op":"check","args":{"lang":"pl","text":"Jest to problem."}},{"op":"check","args":{"lang":"pl","text":"Potrwa to za pewne kilka dni."}},{"op":"check","args":{"lang":"pl","text":"Chciałbym przeprosić za pewne nieporozumienie."}},{"op":"check","args":{"lang":"pl","text":"Za pewne tak uważam."}},{"op":"check","args":{"lang":"pl","text":"Za pewne kwoty można kupić nawet krowę."}},{"op":"check","args":{"lang":"pl","text":"To jest Józef R. Asdaafvafsf"}},{"op":"check","args":{"lang":"pl","text":"To jest cząstka B. Dopiero w niej jest cząstka A."}},{"op":"check","args":{"lang":"pl","text":"Poszedł, kiedy go wołali."}},{"op":"check","args":{"lang":"pl","text":"Któż widział kiedy podobne przepychy?"}},{"op":"check","args":{"lang":"pl","text":"Kupił najroślejszą kobyłę, jaką kiedy w świecie widziano."}},{"op":"check","args":{"lang":"pl","text":"Mojżesz, najłagodniejszy człowiek, jaki był kiedy na ziemi, srodze pokarał zuchwalce."}},{"op":"check","args":{"lang":"pl","text":"Mów pan: jeśli kto kiedy widział…"}},{"op":"check","args":{"lang":"pl","text":"Nie żal się, kretynie."}},{"op":"check","args":{"lang":"pl","text":"Ty się nie żal, kretynie."}},{"op":"check","args":{"lang":"pl","text":"Góralu, czy ci nie żal?"}},{"op":"check","args":{"lang":"pl","text":"Proszę, nie jedź sam!"}},{"op":"check","args":{"lang":"pl","text":"Martwię się o nie."}},{"op":"check","args":{"lang":"pl","text":"Chodziło o nie."}},{"op":"check","args":{"lang":"pl","text":"To nie przelewki."}},{"op":"check","args":{"lang":"pl","text":"To nie tylko grubianin, ale i cham."}},{"op":"check","args":{"lang":"pl","text":"Piszczę nie gorzej od piszczałki."}},{"op":"check","args":{"lang":"pl","text":"On daje mu w ryj."}},{"op":"check","args":{"lang":"pl","text":"On przeżył daje vu."}},{"