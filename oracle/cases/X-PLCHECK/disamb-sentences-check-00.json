{"kind":"harness","clock":"fixed","description":"pl disambiguation.xml example sentences through all rules","normalize":["paths"],"compare":"check","ops":[{"op":"check","args":{"lang":"pl","text":"Punkt 5: zrównać płacę minimalną."}},{"op":"check","args":{"lang":"pl","text":"Pociąg odjeżdża o 15:34."}},{"op":"check","args":{"lang":"pl","text":"O, pan Ostrzeński to kombinator, głowę ma nie od parady."}},{"op":"check","args":{"lang":"pl","text":"Pan Miłkowski pisze te reguły."}},{"op":"check","args":{"lang":"pl","text":"Kupił to nietaniej niż sąsiad."}},{"op":"check","args":{"lang":"pl","text":"Niemniej jednak sprawa jest już przesądzona."}},{"op":"check","args":{"lang":"pl","text":"Co zaś niemniej ważne, ta reguła jest poprawna."}},{"op":"check","args":{"lang":"pl","text":"To jest krowa."}},{"op":"check","args":{"lang":"pl","text":"Lubię go, ale kupię mu pistolet."}},{"op":"check","args":{"lang":"pl","text":"To jest głowa dr. Jekylla."}},{"op":"check","args":{"lang":"pl","text":"Pociąg odjeżdża o 15:45."}},{"op":"check","args":{"lang":"pl","text":"To jest coś, co wiedziałem od dawna."}},{"op":"check","args":{"lang":"pl","text":"Napisał „Gdzie pachną bzy”."}},{"op":"check","args":{"lang":"pl","text":"On był „wyjątkowo” wredny."}},{"op":"check","args":{"lang":"pl","text":"— Gdybyście ją obaczyli — na to Don Kichot — to cóż by za zasługa wasza była, że przyznalibyście prawdę."}},{"op":"check","args":{"lang":"pl","text":"No to co?"}},{"op":"check","args":{"lang":"pl","text":"Jeśli jest to głupi przypadek, jestem w kropce."}},{"op":"check","args":{"lang":"pl","text":"1, 2, 3"}},{"op":"check","args":{"lang":"pl","text":"85,45"}},{"op":"check","args":{"lang":"pl","text":"85,45%"}},{"op":"check","args":{"lang":"pl","text":"On był (jeśli w ogóle można mówić o kimś takim „on”) wyjątkowo wredny."}},{"op":"check","args":{"lang":"pl","text":"On był ( wyjątkowo) wredny."}},{"op":"check","args":{"lang":"pl","text":"On był (wyjątkowo) wredny."}},{"op":"check","args":{"lang":"pl","text":"To były liczby (np. 1, 2), którymi się posługiwał."}},{"op":"check","args":{"lang":"pl","text":"On był – jeśli w ogóle można mówić o kimś takim „on” – wyjątkowo wredny."}},{"op":"check","args":{"lang":"pl","text":"On był – wyjątkowo – wredny."}},{"op":"check","args":{"lang":"pl","text":"„Nie, nie, nie bój się — na to mu Don Kichot — ja mu nie każę, a on rozkazy moje szanować musi”."}},{"op":"check","args":{"lang":"pl","text":"Szef rządu radzieckiego Nikita Chruszczow zaapelował dziewiątego sierpnia bieżącego roku do rządów odnośnych państw - w tym również do rządu tureckiego - by wykazały umiar i bezwzględne poszanowanie niezawisłości."}},{"op":"check","args":{"lang":"pl","text":"Przeszło trzydziestu panów pije wódkę."}},{"op":"check","args":{"lang":"pl","text":"Przeszło 30 panów pije wódkę."}},{"op":"check","args":{"lang":"pl","text":"Turnie, wznosząc się przeszło na cztery tysiące metrów ponad dnem tej przepaści, spadały ku niej prawie pionowo."}},{"op":"check","args":{"lang":"pl","text":"Ta sprawa datuje się przeszło sprzed roku."}},{"op":"check","args":{"lang":"pl","text":"Ty i ja"}},{"op":"check","args":{"lang":"pl","text":"To litera a jest pierwsza."}},{"op":"check","args":{"lang":"pl","text":"Utworzył coś w rodzaju ogromnej litery U, brzuścem dolnym zwrócone do lądu."}},{"op":"check","args":{"lang":"pl","text":"Rusz tylko tę książkę!"}},{"op":"check","args":{"lang":"pl","text":"Co rusz pyta o godzinę."}},{"op":"check","args":{"lang":"pl","text":"Co i rusz pyta o godzinę."}},{"op":"check","args":{"lang":"pl","text":"Dopiero co to zrobiłeś!"}},{"op":"check","args":{"lang":"pl","text":"Co ty robisz?"}},{"op":"check","args":{"lang":"pl","text":"Wysmażył świerszcze na chrupko."}},{"op":"check","args":{"lang":"pl","text":"Mam sporo pieniędzy."}},{"op":"check","args":{"lang":"pl","text":"To było obojętne."}},{"op":"check","args":{"lang":"pl","text":"abadańsko"}},{"op":"check","args":{"lang":"pl","text":"Słownik niemiecko-francuski"}},{"op":"check","args":{"lang":"pl","text":"Słownik polsko-francuski"}},{"op":"check","args":{"lang":"pl","text":"Słownik polsko-indonezyjsko-polinezyjski"}},{"op":"check","args":{"lang":"pl","text":"To było w pierwszej pracy krytycznej Navarrette'a."}},{"op":"check","args":{"lang":"pl","text":"Ani be, ani me, ani kukuryku."}},{"op":"check","args":{"lang":"pl","text":"Ani chybi kupił pstrąga."}},{"op":"check","args":{"lang":"pl","text":"Proszę kremówkę bez kremu."}},{"op":"check","args":{"lang":"pl","text":"Jaki piękny jest bez czarny."}},{"op":"check","args":{"lang":"pl","text":"Jaki piękny jest dziki bez."}},{"op":"check","args":{"lang":"pl","text":"— Oho, odmówiłbym księciu Alby, a majstra Piotra pomieścił — odrzecze gospodarz — jest tu dosyć ludzi, co za widzenie dobrze zapłacą."}},{"op":"check","args":{"lang":"pl","text":"Czas umierać!"}},{"op":"check","args":{"lang":"pl","text":"Czas przygotowania: do 30 minut"}},{"op":"check","args":{"lang":"pl","text":"Nie pieprz!"}},{"op":"check","args":{"lang":"pl","text":"Dodaj sól i pieprz do smaku."}},{"op":"check","args":{"lang":"pl","text":"Czy od dawna tak jest?"}},{"op":"check","args":{"lang":"pl","text":"Od jak dawna tak jest?"}},{"op":"check","args":{"lang":"pl","text":"Szedł z wolna."}},{"op":"check","args":{"lang":"pl","text":"Szedł z bardzo wolna."}},{"op":"check","args":{"lang":"pl","text":"Co gorsza, jadł grzyby."}},{"op":"check","args":{"lang":"pl","text":"Przemókł do cna."}},{"op":"check","args":{"lang":"pl","text":"Wyporządź mi kancelarię do czysta."}},{"op":"check","args":{"lang":"pl","text":"Rozebrała się do naga."}},{"op":"check","args":{"lang":"pl","text":"Do niedawna żarłem jarmuż."}},{"op":"check","args":{"lang":"pl","text":"Podał mu do pełna wypełnioną szklankę."}},{"op":"check","args":{"lang":"pl","text":"Siedziała do późna."}},{"op":"check","args":{"lang":"pl","text":"Wytarł twarz do sucha."}},{"op":"check","args":{"lang":"pl","text":"Najadł się do syta zupą."}},{"op":"check","args":{"lang":"pl","text":"Od rok 2000 jestem nieruchawy."}},{"op":"check","args":{"lang":"pl","text":"Od roku 2000 jestem nieruchawy."}},{"op":"check","args":{"lang":"pl","text":"Dziwny był ten XX w."}},{"op":"check","args":{"lang":"pl","text":"Polska w opiniach obcych X-XII w."}},{"op":"check","args":{"lang":"pl","text":"Mam to w szufladzie."}},{"op":"check","args":{"lang":"pl","text":"To było w w. XX."}},{"op":"check","args":{"lang":"pl","text":"Dużo wody jest w szklance."}},{"op":"check","args":{"lang":"pl","text":"To było w XIX w."}},{"op":"check","args":{"lang":"pl","text":"Te głośniki mają moc 20 W."}},{"op":"check","args":{"lang":"pl","text":"Dziwny XIX w."}},{"op":"check","args":{"lang":"pl","text":"Antonia - wieś w woj. warmińsko-mazurskim."}},{"op":"check","args":{"lang":"pl","text":"Dzięki, mała!"}},{"op":"check","args":{"lang":"pl","text":"To wszystko dzięki pomocy europejskiej."}},{"op":"check","args":{"lang":"pl","text":"Pozdrowił ich i przeszedł mimo, ale Don Kichot zawołał na niego."}},{"op":"check","args":{"lang":"pl","text":"To było 'Przyjęcie u kota'."}},{"op":"check","args":{"lang":"pl","text":"W wormhole'u grawitacja się zagina."}},{"op":"check","args":{"lang":"pl","text":"Był taki jak Cezar."}},{"op":"check","args":{"lang":"pl","text":"Stoję za murem."}},{"op":"check","args":{"lang":"pl","text":"Przesuń to za to."}},{"op":"check","args":{"lang":"pl","text":"To za mało."}},{"op":"check","args":{"lang":"pl","text":"Oni mieli robaki."}},{"op":"check","args":{"lang":"pl","text":"Oni mają robaki."}},{"op":"check","args":{"lang":"pl","text":"To nie powinno być trudne."}},{"op":"check","args":{"lang":"pl","text":"Szatan, podobnie jak teściowa, uwielbia być przyzywany."}},{"op":"check","args":{"lang":"pl","text":"Co słychać?"}},{"op":"check","args":{"lang":"pl","text":"Co prawda ukazuje on silny trend malejący."}},{"op":"check","args":{"lang":"pl","text":"— Co to znaczy?"}},{"op":"check","args":{"lang":"pl","text":"Miły bratku Sancho, bredzisz sam nie wiesz co, w takich awanturach wyspy się nie wygrywają."}},{"op":"check","args":{"lang":"pl","text":"Czyż to piękny ptak."}}]}
