{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "unknown option warning (SRV-0004)",
 "args": [
  "--port",
  "18098",
  "--bogus"
 ],
 "streams": [
  "stdout"
 ],
 "ignoreExit": true,
 "stopOnOutput": "Server started"
}
