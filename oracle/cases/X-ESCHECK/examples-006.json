{"kind":"harness","clock":"fixed","description":"es grammar.xml example sentences 600.., DEFAULT","normalize":["paths"],"compare":"check","ops":[{"op":"check","args":{"lang":"es","text":"No sé a que estás esperando."}},{"op":"check","args":{"lang":"es","text":"No sabe de que le hablas."}},{"op":"check","args":{"lang":"es","text":"Me pregunto con que ideas vendrá."}},{"op":"check","args":{"lang":"es","text":"Sé de que pie cojean."}},{"op":"check","args":{"lang":"es","text":"No lo supe hasta que leí el periódico."}},{"op":"check","args":{"lang":"es","text":"Lo sabe desde que es adulto."}},{"op":"check","args":{"lang":"es","text":"No sé que hacer ahora mismo."}},{"op":"check","args":{"lang":"es","text":"Ya no sabe que hacer para tener notoriedad."}},{"op":"check","args":{"lang":"es","text":"Sabe que partir de una única forma lo conduce necesariamente a la uniformidad."}},{"op":"check","args":{"lang":"es","text":"No sé que pensaría él."}},{"op":"check","args":{"lang":"es","text":"No sé que pensaría."}},{"op":"check","args":{"lang":"es","text":"¿Alguien sabe que pasó?"}},{"op":"check","args":{"lang":"es","text":"Me pregunto que quería."}},{"op":"check","args":{"lang":"es","text":"No hay duda que dicha causa se encuentra abierta."}},{"op":"check","args":{"lang":"es","text":"No sé que debía pensar."}},{"op":"check","args":{"lang":"es","text":"Todos los delegados sabían que debían debatirlo."}},{"op":"check","args":{"lang":"es","text":"Sabe que tiene que correr más rápido que el león."}},{"op":"check","args":{"lang":"es","text":"Ya sé que traes buenas noticias."}},{"op":"check","args":{"lang":"es","text":"Tom sabía que estaría allí."}},{"op":"check","args":{"lang":"es","text":"Estas no son las preguntas que pensábamos hacer."}},{"op":"check","args":{"lang":"es","text":"¿Cuando vendrás?"}},{"op":"check","args":{"lang":"es","text":"¿Para cuando lo quieres?"}},{"op":"check","args":{"lang":"es","text":"¿Y de cuales se trata?"}},{"op":"check","args":{"lang":"es","text":"¿Por cuanto lo vendes?"}},{"op":"check","args":{"lang":"es","text":"¿Como son?"}},{"op":"check","args":{"lang":"es","text":"¿Como estás?"}},{"op":"check","args":{"lang":"es","text":"¿Y de donde vienen?"}},{"op":"check","args":{"lang":"es","text":"¿Y a donde van?"}},{"op":"check","args":{"lang":"es","text":"¿Y adonde van?"}},{"op":"check","args":{"lang":"es","text":"¿Como un hombre tan valiente como tú puede llorar tanto?"}},{"op":"check","args":{"lang":"es","text":"¿Como estas?"}},{"op":"check","args":{"lang":"es","text":"¿Como las que trajo él?"}},{"op":"check","args":{"lang":"es","text":"Pero ¿como para pagar por él tanto o más que por un SEAT León?"}},{"op":"check","args":{"lang":"es","text":"¿Como cuánto te gusta?"}},{"op":"check","args":{"lang":"es","text":"¿Como cuántas veces ves el espejo por día?"}},{"op":"check","args":{"lang":"es","text":"¿Como?"}},{"op":"check","args":{"lang":"es","text":"—¡Que pregunta tan absurda!"}},{"op":"check","args":{"lang":"es","text":"¡Que grande que es!"}},{"op":"check","args":{"lang":"es","text":"¡Pero que bonito!"}},{"op":"check","args":{"lang":"es","text":"¡Con que seriedad se comporta!"}},{"op":"check","args":{"lang":"es","text":"¡Que ruido extraño!"}},{"op":"check","args":{"lang":"es","text":"¡Que venga pronto!"}},{"op":"check","args":{"lang":"es","text":"¡Que empieze ya!"}},{"op":"check","args":{"lang":"es","text":"¡Que viva la república!"}},{"op":"check","args":{"lang":"es","text":"¡Que Dios afeite a la reina!"}},{"op":"check","args":{"lang":"es","text":"¡A que no!"}},{"op":"check","args":{"lang":"es","text":"¡Que Dios nos ayude!"}},{"op":"check","args":{"lang":"es","text":"¡Que Dios salve la reina!"}},{"op":"check","args":{"lang":"es","text":"¡Que Dios derrame sus bendiciones sobre esta familia!"}},{"op":"check","args":{"lang":"es","text":"El ladrón entró en la casa bajo el manto de la noche."}},{"op":"check","args":{"lang":"es","text":"¡Que estúpido es!"}},{"op":"check","args":{"lang":"es","text":"¡Que bonito es!"}},{"op":"check","args":{"lang":"es","text":"¡Que suerte tienes!"}},{"op":"check","args":{"lang":"es","text":"¡Cuan grande que es!"}},{"op":"check","args":{"lang":"es","text":"¡Pero cuan bonito!"}},{"op":"check","args":{"lang":"es","text":"¡Como se lo digo!"}},{"op":"check","args":{"lang":"es","text":"¡Como le he dicho!"}},{"op":"check","args":{"lang":"es","text":"¡Como me gusta!"}},{"op":"check","args":{"lang":"es","text":"¡Pero como me gusta!"}},{"op":"check","args":{"lang":"es","text":"¡Pero como no le va a gustar!"}},{"op":"check","args":{"lang":"es","text":"Ay, ¡como era de niña!"}},{"op":"check","args":{"lang":"es","text":"¡Como si no la conocieras!"}},{"op":"check","args":{"lang":"es","text":"¡Como siempre, has oído mal!"}},{"op":"check","args":{"lang":"es","text":"¡Como yo pensaba, estaban equivocados!"}},{"op":"check","args":{"lang":"es","text":"Al que mal vive, el miedo le sigue."}},{"op":"check","args":{"lang":"es","text":"¡que buena falta te hace!"}},{"op":"check","args":{"lang":"es","text":"Quiero saber a cambio de que."}},{"op":"check","args":{"lang":"es","text":"¿Y bien, Antonio, qué tiene usted que decir?"}},{"op":"check","args":{"lang":"es","text":"Yo que sé, no me gusta nada."}},{"op":"check","args":{"lang":"es","text":"¿Y tú que cuentas?"}},{"op":"check","args":{"lang":"es","text":"Me preguntaba que medidas tomar."}},{"op":"check","args":{"lang":"es","text":"Debes ser prudente al elegir que camino seguir."}},{"op":"check","args":{"lang":"es","text":"Tengo mi propia filosofía de vida, con muchos valores que intento potenciar (porque todavía me queda recorrido)."}},{"op":"check","args":{"lang":"es","text":"¿Por qué no logro acordarme del nombre de la chica que intento olvidar?"}},{"op":"check","args":{"lang":"es","text":"Más vale callar que mal hablar."}},{"op":"check","args":{"lang":"es","text":"Nunca escucha lo que intento decirle."}},{"op":"check","args":{"lang":"es","text":"Unos momentos que hay que saber capturar."}},{"op":"check","args":{"lang":"es","text":"¡Que Dios los bendiga!"}},{"op":"check","args":{"lang":"es","text":"\"Que Yahvé os examine y os juzgue.\""}},{"op":"check","args":{"lang":"es","text":"¡Que Yahvé esté con vosotros!"}},{"op":"check","args":{"lang":"es","text":"Que Mary Boom no sea conocida en el hampa ha resultado ser una gran baza."}},{"op":"check","args":{"lang":"es","text":"¡Que Dios salve la Reina!"}},{"op":"check","args":{"lang":"es","text":"Que mujer tan inteligente."}},{"op":"check","args":{"lang":"es","text":"¡Que suerte que te tocase la lotería!"}},{"op":"check","args":{"lang":"es","text":"Que 3/4 de Argentina y el MUNDO ENTERO se equivoca."}},{"op":"check","args":{"lang":"es","text":"Que claro que no es por mí."}},{"op":"check","args":{"lang":"es","text":"Que dios las bendiga siempre."}},{"op":"check","args":{"lang":"es","text":"Todos éramos felices, hasta que terceras personas irrumpieron en nuestra vida."}},{"op":"check","args":{"lang":"es","text":"He allí que otro soldado viene en nuestro auxilio y me ayudan con el herido."}},{"op":"check","args":{"lang":"es","text":"Tom encuentra mucho más fácil hablar inglés que francés."}},{"op":"check","args":{"lang":"es","text":"Más valen amigos en la plaza que dinero en el arca."}},{"op":"check","args":{"lang":"es","text":"Es mejor una palabra a tiempo, que dos a destiempo."}},{"op":"check","args":{"lang":"es","text":"Tom habla alemán igual de bien que inglés."}},{"op":"check","args":{"lang":"es","text":"y alguna que otra información"}},{"op":"check","args":{"lang":"es","text":"como algún que otro dinosaurio."}},{"op":"check","args":{"lang":"es","text":"Es por eso que perseverancia y disciplina son dos palabras clave."}},{"op":"check","args":{"lang":"es","text":"por qué razón afirma usted que sir Arthur estaba cansado"}},{"op":"check","args":{"lang":"es","text":"Es posible que millones de personas no tengan acceso."}},{"op":"check","args":{"lang":"es","text":"Esto no impidió que numerosos intelectuales se unieran al Partido"}},{"op":"check","args":{"lang":"es","text":"Puedo inferir que loco no está."}}]}
