{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli-log",
 "realLogging": true,
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "--enable-temp-off prints \"Activating <id>, which is default=temp_off\" on STDOUT (not a log record)",
 "args": [
  "-l",
  "en-US",
  "-eo",
  "--enable-temp-off",
  "-e",
  "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
  "-"
 ],
 "stdin": "This is a test,, ok."
}
