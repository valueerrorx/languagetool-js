{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli-log",
 "realLogging": true,
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "--port 0 with minPort/maxPort: free port search logs",
 "args": [
  "--port",
  "0",
  "--config",
  "p.properties"
 ],
 "files": {
  "p.properties": "minPort=18380\nmaxPort=18383\n"
 },
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "streams": [
  "stdout"
 ],
 "ignoreExit": true,
 "stopOnOutput": "Server started"
}
