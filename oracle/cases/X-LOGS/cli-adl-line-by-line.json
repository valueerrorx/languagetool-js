{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli-log",
 "realLogging": true,
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "-adl -l-style options: line by line",
 "args": [
  "-adl",
  "--line-by-line",
  "-eo",
  "-e",
  "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
  "-"
 ],
 "stdin": "This is a small English text to test the language detection,, with two commas.\nAnother English line follows right here,, and here.\n"
}
