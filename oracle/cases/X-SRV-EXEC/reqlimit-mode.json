{
 "kind": "http",
 "clock": "fixed",
 "description": "text level only requests count less against requestLimit",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "reqlimit-mode",
