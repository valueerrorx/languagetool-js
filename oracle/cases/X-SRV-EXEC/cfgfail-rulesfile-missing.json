{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "rulesFile pointing to a missing file is refused at startup",
 "args": [
  "--config",
  "bad.properties",
  "--port",
  "18394"
 ],
 "files": {
  "bad.properties": "rulesFile=does-not-exist.cfg\n"
 }
}
