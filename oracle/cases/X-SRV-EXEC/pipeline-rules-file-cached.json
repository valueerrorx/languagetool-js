{
 "kind": "http",
 "clock": "fixed",
 "description": "rulesFile together with pipelineCaching",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "pipeline-rules-file-cached",
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "rulesFile={WORK}/rules.cfg\npipelineCaching=true\nmaxPipelinePoolSize=3\n",
  "rules.cfg": "disabledRules.en=DOUBLE_PUNCTUATION\ndisabledRules=WHITESPACE_RULE\nenabledRules.en=ENGLISH_WORD_REPEAT_RULE\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,,  ok. The the cat sat on teh mat."
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,,  ok. The the cat sat on teh mat.",
    "level": "picky"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
