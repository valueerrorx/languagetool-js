{
 "kind": "http",
 "clock": "fixed",
 "description": "pipelinePrewarming=true without pipelineCaching still runs the prewarm checks",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit",
  "sysLoad",
  "identityHash"
 ],
 "isolate": "pipeline-prewarm-nocache",
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "pipelinePrewarming=true\npreferredLanguages=en-US\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "This is a test,, ok."
   }
  },
  {
   "method": "GET",
   "path": "/v2/healthcheck"
  }
 ]
}
