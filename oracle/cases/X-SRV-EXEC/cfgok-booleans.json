{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "stderrExceptionOnly": true,
 "description": "pipelineCaching/pipelinePrewarming booleans accept junk as false; server starts",
 "args": [
  "--config",
  "ok.properties",
  "--port",
  "18392"
 ],
 "files": {
  "ok.properties": "pipelineCaching=maybe\npipelinePrewarming=maybe\nmaxPipelinePoolSize=3\nmaxCheckTimeMillis=-1\n"
 },
 "streams": [
  "stdout"
 ],
 "ignoreExit": true,
 "stopOnOutput": "Server started"
}
