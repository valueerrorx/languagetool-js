{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "ruleIdToConfidenceFile without {lang}",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18167"
 ],
 "files": {
  "c.properties": "ruleIdToConfidenceFile=conf.csv\n",
  "conf.csv": "X,0.5\n"
 }
}
