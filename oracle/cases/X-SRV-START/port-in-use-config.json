{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "port in use with a config file",
 "stderrExceptionOnly": true,
 "args": [
  "--port",
  "18187",
  "--config",
  "c.properties"
 ],
 "files": {
  "c.properties": "maxTextLength=10\n"
 },
 "occupyPorts": [
  18187
 ]
}
