{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--languageModel before --config (order irrelevant for the ignore rule; server starts)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--languageModel",
  "lm",
  "--config",
  "c.properties",
  "--port",
  "18177"
 ],
 "files": {
  "c.properties": "languageModel=nolm\n",
  "lm/readme.txt": "x"
 }
}
