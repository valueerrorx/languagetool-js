{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "fasttextBinary missing (model ok)",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18158"
 ],
 "files": {
  "c.properties": "fasttextModel=m.bin\nfasttextBinary=nobin\n",
  "m.bin": "x"
 }
}
