{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "dictPath is a directory",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18179"
 ],
 "files": {
  "c.properties": "lang-tr=Turkish\nlang-tr-dictPath=dyn/dir.dic\n",
  "dyn/dir.dic/x": "x"
 }
}
