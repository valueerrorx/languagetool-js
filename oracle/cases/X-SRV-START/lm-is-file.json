{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--languageModel pointing to a file",
 "stderrExceptionOnly": true,
 "args": [
  "--languageModel",
  "afile",
  "--port",
  "18172"
 ],
 "files": {
  "afile": "x"
 }
}
