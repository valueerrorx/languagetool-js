{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--logIpMatchingPattern value",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--logIpMatchingPattern",
  "MY_PATTERN",
  "--port",
  "18160"
 ]
}
