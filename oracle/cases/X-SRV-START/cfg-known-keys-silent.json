{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "SRV-0058: keystore/password/trustedSource and other known keys do not warn",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18150"
 ],
 "files": {
  "c.properties": "keystore=k\npassword=p\ntrustedSource=x\nmaxTextLengthWithApiKey=5\nmaxCheckTimeWithApiKeyMillis=5\n"
 }
}
