{
 "kind": "http",
 "clock": "fixed",
 "description": "maxTextHardLength smaller than maxTextLength: body guard acts first",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "maxTextHardLength=10\nmaxTextLength=100000\n"
 },
 "requests": [
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "body": "language=en-US&text=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "contentType": "application/x-www-form-urlencoded"
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "body": "language=en-US&",
   "contentType": "application/x-www-form-urlencoded"
  },
  {
   "method": "GET",
   "path": "/v2/maxtextlength"
  }
 ]
}
