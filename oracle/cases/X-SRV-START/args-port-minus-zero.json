{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--port -0 is port 0 without minPort/maxPort",
 "stderrExceptionOnly": true,
 "args": [
  "--port",
  "-0"
 ]
}
