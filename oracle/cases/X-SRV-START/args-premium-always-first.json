{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--premiumAlways before unknown options (parsing stops at the exception)",
 "stderrExceptionOnly": true,
 "args": [
  "--premiumAlways",
  "--foo",
  "--port",
  "18170"
 ]
}
