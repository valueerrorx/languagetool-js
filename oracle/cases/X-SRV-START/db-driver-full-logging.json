{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "as above with dbLogging=true (server starts)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18159"
 ],
 "files": {
  "c.properties": "dbLogging=true\ndbDriver=org.nonexistent.Driver\ndbUrl=jdbc:x:y\ndbUsername=u\ndbPassword=p\n"
 }
}
