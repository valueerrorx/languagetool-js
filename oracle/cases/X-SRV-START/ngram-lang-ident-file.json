{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "ngramLangIdentData existing file that is not a ZIP: startup fails",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18167"
 ],
 "files": {
  "c.properties": "ngramLangIdentData=z.zip\n",
  "z.zip": "x"
 }
}
