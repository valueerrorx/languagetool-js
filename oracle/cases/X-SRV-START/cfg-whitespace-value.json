{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "leading whitespace of a value is stripped, trailing kept (unknown key echo is only the key)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18151"
 ],
 "files": {
  "c.properties": "anonymousAccessAllowed=   true\nsuggestionsEnabled=true   \n"
 }
}
