{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "two dynamic languages (tr, sv)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18156"
 ],
 "files": {
  "c.properties": "lang-tr=Turkish\nlang-tr-dictPath=dyn/tr.dic\nlang-sv=Swedish\nlang-sv-dictPath=dyn/sv.dic\n",
  "dyn/tr.dic": "4\nhello\nworld\nfoo/S\nBär\n",
  "dyn/tr.aff": "SET UTF-8\nSFX S Y 1\nSFX S 0 s .\n",
  "dyn/common_words.txt": "hello\nworld\nfoo\n",
  "dyn/sv.dic": "2\nhej\nvärld\n",
  "dyn/sv.aff": "SET UTF-8\n"
 }
}
