{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "hunspell .aff missing (server starts)",
 "ignoreExit": true,
 "stopOnOutput": "Server started",
 "stderrFilter": "^(\\*{5} WARNING|Key '|Known keys:|WARNING:|\\*\\*\\* |Exception in thread|Caused by:)",
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18153"
 ],
 "files": {
  "c.properties": "lang-tr=Turkish\nlang-tr-dictPath=dyn/tr.dic\n",
  "dyn/tr.dic": "1\nhello\n",
  "dyn/common_words.txt": "hello\n"
 }
}
