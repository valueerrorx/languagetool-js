{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--logIpMatchingPattern --x",
 "stderrExceptionOnly": true,
 "args": [
  "--port",
  "18168",
  "--logIpMatchingPattern",
  "--x"
 ]
}
