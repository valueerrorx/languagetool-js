{
 "kind": "http",
 "clock": "fixed",
 "description": "--verbose with a config file",
 "compare": "api",
 "normalize": [
  "buildDate",
  "commit"
 ],
 "stopAfter": true,
 "serverArgs": [
  "-v",
  "--config",
  "{WORK}/server.properties"
 ],
 "files": {
  "server.properties": "maxTextLength=12\n"
 },
 "requests": [
  {
   "method": "GET",
   "path": "/v2/maxtextlength"
  },
  {
   "method": "POST",
   "path": "/v2/check",
   "params": {
    "language": "en-US",
    "text": "aaaaaaaaaaaaa",
    "enabledRules": "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,ENGLISH_WORD_REPEAT_RULE,EN_UNPAIRED_BRACKETS,EN_UNPAIRED_QUOTES,SENTENCE_WHITESPACE,UPPERCASE_SENTENCE_START,WHITESPACE_PUNCTUATION,WHITESPACE_RULE",
    "enabledOnly": "true"
   }
  }
 ]
}
