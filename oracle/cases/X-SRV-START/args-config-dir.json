{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "--config pointing to a directory",
 "stderrExceptionOnly": true,
 "args": [
  "--port",
  "18164",
  "--config",
  "."
 ]
}
