{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "jar": "languagetool-server.jar",
 "mainClass": "org.languagetool.server.HTTPServer",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames"
 ],
 "stripTimestamp": true,
 "description": "fasttextBinary not executable",
 "stderrExceptionOnly": true,
 "args": [
  "--config",
  "c.properties",
  "--port",
  "18160"
 ],
 "files": {
  "c.properties": "fasttextModel=m.bin\nfasttextBinary=b.bin\n",
  "m.bin": "x",
  "b.bin": "x"
 }
}
