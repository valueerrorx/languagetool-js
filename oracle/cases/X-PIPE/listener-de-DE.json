  {
   "op": "pipe-check",
   "args": {
    "lang": "de-DE",
    "rules": [
     {
      "id": "SYN_BAD",
      "regex": "(?i)bad|worse|schlecht|mauvais",
      "message": "Bad word {t}",
      "shortMessage": "bad",
      "suggestions": [
       "good",
       "{t}ly"
      ],
      "category": {
       "id": "SYN_CAT_A",
       "name": "Synthetic A"
      },
      "description": "bad words"
     },
     {
      "id": "SYN_PICKY",
      "regex": "very|très|sehr",
      "message": "Picky {t}",
      "tags": [
       "picky"
      ],
      "category": {
       "id": "SYN_CAT_B",
       "name": "Synthetic B"
      }
     },
     {
      "id": "SYN_SUB",
      "subId": "1",
      "regex": "colou?r",
      "message": "Sub one {t}",
      "category": {
       "id": "SYN_CAT_B",
       "name": "Synthetic B"
      }
     },
     {
      "id": "SYN_SUB",
      "subId": "2",
      "regex": "color|colour|couleur",
      "message": "Sub two {t}",
      "category": {
       "id": "SYN_CAT_B",
       "name": "Synthetic B"
      }
     },
     {
      "id": "SYN_TONE",
      "regex": "gonna|hey|salut",
      "message": "Tone {t}",
      "toneTags": [
       "formal"
      ],
      "category": {
       "id": "SYN_CAT_A",
       "name": "Synthetic A"
      }
     },
     {
      "id": "SYN_URL",
      "regex": "link",
      "message": "Url {t}",
      "url": "https://example.org/x?a=1&b=2",
      "category": {
       "id": "SYN_CAT_A",
       "name": "Synthetic A"
      }
     },
     {
      "id": "SYN_TXT",
      "kind": "text",
      "regex": "(?i)the end|\\bbad\\b[^.]{0,30}\\bworse\\b|fin\\.",
      "message": "Text-level {t}",
      "suggestions": [
       "END"
      ],
      "minToCheckParagraph": 2,
      "category": {
       "id": "SYN_CAT_D",
       "name": "Synthetic D"
      }
     },
     {
      "id": "SYN_TXTPARA",
      "kind": "text",
      "regex": "\\n\\n|\\r\\n\\r\\n",
      "message": "Para break",
      "category": {
       "id": "SYN_CAT_D",
       "name": "Synthetic D"
      }
     }
    ],
    "opts": {
     "listener": true
    },
    "cases": [
     {
      "text": "This is bad. That is worse than foo.",
      "level": "PICKY"
     },
     {
      "text": "bad foo very color colour",
      "level": "PICKY"
     },
     {
      "text": "Para one bad.\n\nPara two bad very.\n\nThe end",
      "level": "PICKY"
     },
     {
      "text": "The end is bad and worse. The end.",
      "level": "PICKY"
     },
     {
      "text": "",
      "level": "PICKY"
     },
     {
      "text": "color\n\ncolour bad",
      "level": "PICKY"
     }
    ]
   }
