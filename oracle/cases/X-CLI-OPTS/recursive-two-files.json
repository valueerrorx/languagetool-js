{
 "kind": "cli",
 "clock": "fixed",
 "compare": "cli",
 "normalize": [
  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "CLI-0060: two files (listFiles order is filesystem dependent; order recorded as-is)",
 "args": [
  "-l",
  "en-US",
  "-eo",
  "-e",
  "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,UPPERCASE_SENTENCE_START,WHITESPACE_RULE,EN_UNPAIRED_BRACKETS,ENGLISH_WORD_REPEAT_RULE,SENTENCE_WHITESPACE",
  "-r",
  "dir"
 ],
 "files": {
  "dir/a.txt": "Hi there there.\n",
  "dir/b.txt": "Second  file.\n"
 },
 "orderDependent": true
}
