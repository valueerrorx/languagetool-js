  "buildDate",
  "commit",
  "stackFrames",
  "paths"
 ],
 "description": "CLI-0035: comments, CDATA, processing instruction",
 "args": [
  "-l",
  "en-US",
  "-eo",
  "-e",
  "COMMA_PARENTHESIS_WHITESPACE,DOUBLE_PUNCTUATION,UPPERCASE_SENTENCE_START,WHITESPACE_RULE,EN_UNPAIRED_BRACKETS,ENGLISH_WORD_REPEAT_RULE,SENTENCE_WHITESPACE",
  "--xmlfilter",
  "-"
 ],
 "stdin": "<?xml version=\"1.0\"?><!-- a a --><r><![CDATA[x x]]>there there</r>"
}
